# Supabase Configuration
# Note: These are PUBLIC keys meant to be exposed in the client bundle.
# The anon key is safe to expose - it's protected by Row Level Security (RLS) in Supabase.

# For local development, use VITE_ prefix:
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site URL for email links (used in password reset, invites, etc.)
# Local: http://localhost:3001
# Production: https://thewall.callum.digital
VITE_SITE_URL=http://localhost:3001

# For Vercel deployment, use without VITE_ prefix (see vercel-env-example.txt):
# SUPABASE_URL=your-supabase-project-url
# SUPABASE_ANON_KEY=your-supabase-anon-key


