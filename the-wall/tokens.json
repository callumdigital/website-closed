{
  "color": {
    "brand": {
      "primary": "#3B82F6",
      "secondary": "#8B5CF6",
      "accent": "#F59E0B"
    },
    "surface": {
      "base": "#FFFFFF",
      "muted": "#F8FAFC",
      "elevated": "#FFFFFF"
    },
    "status": {
      "success": {
        "bg": "#D1FAE5",
        "border": "#10B981",
        "text": "#065F46"
      },
      "warning": {
        "bg": "#FEF3C7",
        "border": "#F59E0B",
        "text": "#92400E"
      },
      "danger": {
        "bg": "#FEE2E2",
        "border": "#EF4444",
        "text": "#991B1B"
      },
      "info": {
        "bg": "#DBEAFE",
        "border": "#3B82F6",
        "text": "#1E40AF"
      }
    }
  },
  "border": {
    "radius": {
      "sm": "14px",
      "md": "20px",
      "lg": "24px",
      "xl": "28px",
      "full": "9999px"
    },
    "width": {
      "sm": "2px",
      "md": "3px",
      "lg": "4px"
    },
    "color": {
      "default": "#000000",
      "muted": "#E5E7EB"
    }
  },
  "accessibility": {
    "contrast": {
      "textOnLight": "#1F2937",
      "textOnDark": "#FFFFFF",
      "textMuted": "#6B7280"
    },
    "focus": {
      "ringOffset": "2px",
      "outlineOffset": "2px"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": ["Inter", "system-ui", "sans-serif"],
      "display": ["Inter", "system-ui", "sans-serif"],
      "accent": ["Inter", "system-ui", "sans-serif"]
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "lineHeight": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "spacing": {
    "button": {
      "sm": {
        "px": "0.75rem",
        "py": "0.5rem"
      },
      "md": {
        "px": "1rem",
        "py": "0.75rem"
      },
      "lg": {
        "px": "1.25rem",
        "py": "1rem"
      }
    },
    "card": {
      "sm": {
        "p": "1rem"
      },
      "md": {
        "p": "1.5rem"
      },
      "lg": {
        "p": "2rem"
      }
    },
    "modal": {
      "maxHeight": "90vh"
    }
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms"
    },
    "easing": {
      "ease": "ease",
      "easeIn": "ease-in",
      "easeOut": "ease-out",
      "easeInOut": "ease-in-out"
    },
    "transform": {
      "hover": {
        "lift": "translateY(-2px)",
        "liftMore": "translateY(-4px)",
        "press": "translateY(1px)"
      }
    }
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
  }
}
